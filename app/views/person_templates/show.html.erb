<h1>
  Person #<%= @the_person.id %> details
</h1>

<article>
  <div>
    <a href="/people">
      Go back
    </a>
  </div>

  <div>
    <a href="/delete_person/<%= @the_person.id %>">
      Delete person
    </a>
  </div>
  <dl>
    <dt>
      Names
    </dt>
    <dd>
      <%= @the_person.names %>
    </dd>

    <dt>
      Birthday
    </dt>
    <dd>
      <%= @the_person.birthday %>
    </dd>

    <dt>
      Created at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_person.created_at) %> ago
    </dd>

    <dt>
      Updated at
    </dt>
    <dd>
      <%= time_ago_in_words(@the_person.updated_at) %> ago
    </dd>
  </dl>
</article>

<hr>


<article>
  <header>
    <h2>
      Edit person
    </h2>
  </header>

  <form action="/modify_person/<%= @the_person.id %>"  method="post" >
    <div>
      <label for="names_box">
        Names
      </label>

      <input type="text" id="names_box" name="query_names" value="<%= @the_person.names %>">
    </div>

    <div>
      <label for="birthday_box">
        Birthday
      </label>

      <input type="date" id="birthday_box" name="query_birthday" value="<%= @the_person.birthday %>">
    </div>

    <button type="submit">
      Update person
    </button>
  </form>
</article>

<hr>
