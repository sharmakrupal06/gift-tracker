<h1><%= @the_person.name %></h1>

<article>
  <div>
    <a href="/people">← Go back to all people</a>
  </div>

  <dl>
    <dt>Name</dt>
    <dd><%= @the_person.name %></dd>

    <dt>Relationship</dt>
    <dd><%= @the_person.relationship.presence || "—" %></dd>

    <dt>Birthday</dt>
    <dd><%= @the_person.birthday.strftime("%B %d, %Y") %></dd>

    <dt>Next Birthday</dt>
    <dd><%= @the_person.next_birthday.strftime("%B %d, %Y") %></dd>
  </dl>

  <form action="/people/<%= @the_person.id %>" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <input type="hidden" name="_method" value="delete">
    <button type="submit">Delete person</button>
  </form>
</article>

<hr>

<article>
  <header>
    <h2>Edit person</h2>
  </header>

  <form action="/people/<%= @the_person.id %>" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <input type="hidden" name="_method" value="patch">

    <div>
      <label for="name_box">Name</label>
      <input type="text" id="name_box" name="query_name" value="<%= @the_person.name %>">
    </div>

    <div>
      <label for="relationship_box">Relationship</label>
      <input type="text" id="relationship_box" name="query_relationship" placeholder="e.g. Friend, Sister, Colleague" value="<%= @the_person.relationship %>">
    </div>

    <div>
      <label for="birthday_box">Birthday</label>
      <input type="date" id="birthday_box" name="query_birthday" value="<%= @the_person.birthday %>">
    </div>

    <button type="submit">Update person</button>
  </form>
</article>

<hr>

<article>
  <header>
    <h2>📅 Important Dates for <%= @the_person.name %></h2>
  </header>

  <form action="/people/<%= @the_person.id %>/events" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <div style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
      <div>
        <label for="event_type_box">Type</label>
        <input type="text" id="event_type_box" name="query_event_type" placeholder="e.g. Anniversary, Graduation">
      </div>
      <div>
        <label for="event_date_box">Date</label>
        <input type="date" id="event_date_box" name="query_date">
      </div>
      <div>
        <label for="event_note_box">Note (optional)</label>
        <input type="text" id="event_note_box" name="query_note" placeholder="e.g. 10 year anniversary!">
      </div>
      <div>
        <button type="submit">Add Date</button>
      </div>
    </div>
  </form>

  <% if @the_person.events.any? %>
    <ul>
      <% @the_person.events.order(:date).each do |event| %>
        <li>
          <strong><%= event.event_type %></strong> — <%= event.date.strftime("%B %d, %Y") %>
          <% if event.note.present? %> · <em><%= event.note %></em><% end %>
          <form action="/people/<%= @the_person.id %>/events/<%= event.id %>" method="post" style="display:inline;">
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" style="background:none; border:none; color:red; cursor:pointer; padding:0; font-size:inherit;">❌</button>
          </form>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No important dates added yet.</p>
  <% end %>
</article>

<hr>

<article>
  <header>
    <h2>🎁 Gifts for <%= @the_person.name %></h2>
  </header>

  <a href="/people/<%= @the_person.id %>/gifts_givens">+ Add a Gift</a>

  <% if @the_person.gifts_givens.any? %>
    <table>
      <thead>
        <tr>
          <th>Gift</th>
          <th>Occasion</th>
          <th>Given On</th>
          <th>Liked?</th>
          <th>Price</th>
          <th>Notes</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @the_person.gifts_givens.order(given_on: :desc).each do |gift| %>
          <tr>
            <td><%= gift.gift %></td>
            <td><%= gift.occasion.presence || "—" %></td>
            <td><%= gift.given_on&.strftime("%B %d, %Y") %></td>
            <td><%= gift.liked ? "✅" : "❌" %></td>
            <td><%= gift.price ? "$#{gift.price}" : "—" %></td>
            <td><%= gift.notes.presence || "—" %></td>
            <td>
              <a href="/people/<%= @the_person.id %>/gifts_givens/<%= gift.id %>">Edit</a>
              |
              <form action="/people/<%= @the_person.id %>/gifts_givens/<%= gift.id %>" method="post" style="display:inline;">
                <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                <input type="hidden" name="_method" value="delete">
                <button type="submit" style="background:none; border:none; color:red; cursor:pointer; padding:0; font-size:inherit;">Delete</button>
              </form>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No gifts recorded yet for <%= @the_person.name %>.</p>
  <% end %>
</article>

<hr>

<article>
  <header>
    <h2>💡 Gift Ideas for <%= @the_person.name %></h2>
  </header>

  <form action="/people/<%= @the_person.id %>/gift_ideas" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <input type="text" name="query_description" placeholder="Add a gift idea...">
    <button type="submit">Add Idea</button>
  </form>

  <% if @the_person.gift_ideas.any? %>
    <ul>
      <% @the_person.gift_ideas.each do |idea| %>
        <li>
          <% if idea.purchased %>
            <s><%= idea.description %></s> ✅ Purchased
          <% else %>
            <%= idea.description %>
            <form action="/people/<%= @the_person.id %>/gift_ideas/<%= idea.id %>" method="post" style="display:inline;">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <input type="hidden" name="_method" value="patch">
              <input type="hidden" name="query_purchased" value="true">
              <button type="submit">✅ Mark Purchased</button>
            </form>
          <% end %>
          <form action="/people/<%= @the_person.id %>/gift_ideas/<%= idea.id %>" method="post" style="display:inline;">
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            <input type="hidden" name="_method" value="delete">
            <button type="submit">❌</button>
          </form>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No gift ideas yet.</p>
  <% end %>
</article>
