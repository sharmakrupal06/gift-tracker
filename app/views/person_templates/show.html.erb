<div class="profile-header">
  <div>
    <h1 style="margin-bottom: 0.25rem;"><%= @the_person.name %></h1>
    <a href="/people" style="font-size: 0.9rem;">← Back to all people</a>
  </div>
  <form action="/people/<%= @the_person.id %>" method="post" style="margin:0;">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <input type="hidden" name="_method" value="delete">
    <button type="submit" class="outline" style="color: #e63946; border-color: #e63946; font-size: 0.85rem; padding: 0.4rem 0.8rem;">🗑 Delete</button>
  </form>
</div>

<%# Profile Info %>
<article>
  <dl class="profile-dl">
    <dt>Relationship</dt>
    <dd><%= @the_person.relationship.presence || "—" %></dd>

    <dt>Birthday</dt>
    <dd><%= @the_person.birthday.strftime("%B %d, %Y") %></dd>

    <dt>Next Birthday</dt>
    <dd>
      <%= @the_person.next_birthday.strftime("%B %d, %Y") %>
      <% days_until = (@the_person.next_birthday - Date.today).to_i %>
      <% if days_until == 0 %>
        🎉 <strong>Today!</strong>
      <% elsif days_until <= 30 %>
        · <span class="days-badge" style="font-size:0.8rem;">⏰ <%= days_until %> days</span>
      <% end %>
    </dd>

    <% if @the_person.notes.present? %>
      <dt>Notes</dt>
      <dd><%= @the_person.notes %></dd>
    <% end %>
  </dl>
</article>

<hr>

<%# Edit Person %>
<details>
  <summary style="font-size: 1rem; font-weight: 600; cursor: pointer;">✏️ Edit <%= @the_person.name %></summary>
  <article style="margin-top: 0.75rem;">
    <form action="/people/<%= @the_person.id %>" method="post">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" name="_method" value="patch">

      <div class="form-row">
        <div>
          <label for="name_box">Name</label>
          <input type="text" id="name_box" name="query_name" value="<%= @the_person.name %>">
        </div>
        <div>
          <label for="relationship_box">Relationship</label>
          <input type="text" id="relationship_box" name="query_relationship" placeholder="e.g. Friend, Sister" value="<%= @the_person.relationship %>">
        </div>
        <div>
          <label for="birthday_box">Birthday</label>
          <input type="date" id="birthday_box" name="query_birthday" value="<%= @the_person.birthday %>">
        </div>
      </div>

      <div>
        <label for="notes_box">Notes (optional)</label>
        <textarea id="notes_box" name="query_notes" placeholder="e.g. Loves hiking, allergies: nuts, clothing size M"><%= @the_person.notes %></textarea>
      </div>

      <button type="submit">Update Person</button>
    </form>
  </article>
</details>

<hr>

<%# Important Dates %>
<article>
  <div class="section-header">
    <h2>📅 Important Dates</h2>
  </div>

  <form action="/people/<%= @the_person.id %>/events" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <div class="form-row">
      <div>
        <label for="event_type_box">Type</label>
        <input type="text" id="event_type_box" name="query_event_type" placeholder="e.g. Anniversary">
      </div>
      <div>
        <label for="event_date_box">Date</label>
        <input type="date" id="event_date_box" name="query_date">
      </div>
      <div>
        <label for="event_note_box">Note (optional)</label>
        <input type="text" id="event_note_box" name="query_note" placeholder="e.g. 10 year anniversary!">
      </div>
      <div style="flex:0;">
        <label style="visibility:hidden;">Add</label>
        <button type="submit">Add</button>
      </div>
    </div>
  </form>

  <% if @the_person.events.any? %>
    <ul class="events-list">
      <% @the_person.events.order(:date).each do |event| %>
        <li>
          <div>
            <strong><%= event.event_type %></strong>
            <span style="color: var(--pico-muted-color); font-size: 0.85rem;"> — <%= event.date.strftime("%B %d, %Y") %></span>
            <% if event.note.present? %><br><em style="font-size: 0.85rem;"><%= event.note %></em><% end %>
          </div>
          <form action="/people/<%= @the_person.id %>/events/<%= event.id %>" method="post" style="margin:0;">
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="btn-delete">✕</button>
          </form>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p style="color: var(--pico-muted-color); font-size: 0.9rem; margin-top: 0.75rem;">No important dates added yet.</p>
  <% end %>
</article>

<hr>

<%# Gifts Given %>
<article>
  <div class="section-header">
    <h2>🎁 Gifts Given</h2>
    <a href="/people/<%= @the_person.id %>/gifts_givens" role="button" class="outline" style="font-size: 0.85rem; padding: 0.3rem 0.8rem;">+ Add Gift</a>
  </div>

  <% if @the_person.gifts_givens.any? %>
    <div style="overflow-x: auto;">
      <table style="font-size: 0.88rem;">
        <thead>
          <tr>
            <th>Gift</th>
            <th>Occasion</th>
            <th>Given On</th>
            <th>Liked?</th>
            <th>Price</th>
            <th>Notes</th>
            <th>Link</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @the_person.gifts_givens.order(given_on: :desc).each do |gift| %>
            <tr>
              <td><%= gift.gift %></td>
              <td><%= gift.occasion.presence || "—" %></td>
              <td><%= gift.given_on&.strftime("%b %d, %Y") %></td>
              <td><%= gift.liked ? "✅" : "❌" %></td>
              <td><%= gift.price ? "$#{gift.price}" : "—" %></td>
              <td><%= gift.notes.presence || "—" %></td>
              <td>
                <% if gift.url.present? %>
                  <a href="<%= gift.url %>" target="_blank">View ↗</a>
                <% else %>
                  —
                <% end %>
              </td>
              <td>
                <a href="/people/<%= @the_person.id %>/gifts_givens/<%= gift.id %>" style="font-size:0.85rem;">Edit</a>
                &nbsp;
                <form action="/people/<%= @the_person.id %>/gifts_givens/<%= gift.id %>" method="post" style="display:inline; margin:0;">
                  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                  <input type="hidden" name="_method" value="delete">
                  <button type="submit" class="btn-delete">✕</button>
                </form>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p style="color: var(--pico-muted-color); font-size: 0.9rem;">No gifts recorded yet.</p>
  <% end %>
</article>

<hr>

<%# Gift Ideas %>
<article>
  <div class="section-header">
    <h2>💡 Gift Ideas</h2>
  </div>

  <form action="/people/<%= @the_person.id %>/gift_ideas" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <div class="form-row">
      <div>
        <label for="idea_description_box">Idea</label>
        <input type="text" id="idea_description_box" name="query_description" placeholder="Add a gift idea...">
      </div>
      <div>
        <label for="idea_url_box">Link (optional)</label>
        <input type="text" id="idea_url_box" name="query_url" placeholder="e.g. https://amazon.com/...">
      </div>
      <div style="flex:0;">
        <label style="visibility:hidden;">Add</label>
        <button type="submit">Add</button>
      </div>
    </div>
  </form>

  <% if @the_person.gift_ideas.any? %>
    <ul class="ideas-list">
      <% @the_person.gift_ideas.each do |idea| %>
        <li>
          <div style="flex:1;">
            <% if idea.purchased %>
              <s style="color: var(--pico-muted-color);"><%= idea.description %></s> ✅
            <% else %>
              <%= idea.description %>
            <% end %>
            <% if idea.url.present? %>
              · <a href="<%= idea.url %>" target="_blank" style="font-size:0.85rem;">View ↗</a>
            <% end %>
          </div>
          <div style="display:flex; gap:0.5rem; align-items:center; flex-shrink:0;">
            <% unless idea.purchased %>
              <form action="/people/<%= @the_person.id %>/gift_ideas/<%= idea.id %>" method="post" style="margin:0;">
                <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                <input type="hidden" name="_method" value="patch">
                <input type="hidden" name="query_purchased" value="true">
                <button type="submit" class="outline" style="font-size:0.8rem; padding: 0.2rem 0.6rem;">✅ Purchased</button>
              </form>
            <% end %>
            <form action="/people/<%= @the_person.id %>/gift_ideas/<%= idea.id %>" method="post" style="margin:0;">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="btn-delete">✕</button>
            </form>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p style="color: var(--pico-muted-color); font-size: 0.9rem;">No gift ideas yet.</p>
  <% end %>
</article>
