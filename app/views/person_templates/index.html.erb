<h1>🎂 Birthday Tracker</h1>

<%# Display 1: Upcoming in Next 30 Days %>
<h2>🎉 Coming Up in the Next 30 Days</h2>
<article>
  <%
    upcoming_items = []

    @list_of_people.each do |person|
      days = (person.next_birthday - Date.today).to_i
      if days <= 30
        upcoming_items << {
          type: :birthday,
          person: person,
          label: "#{person.name}'s Birthday",
          date: person.birthday.strftime("%B %d"),
          days: days
        }
      end

      person.events.each do |event|
        days = (event.next_occurrence - Date.today).to_i
        if days <= 30
          upcoming_items << {
            type: :event,
            person: person,
            label: "#{person.name} — #{event.event_type}",
            date: event.date.strftime("%B %d"),
            days: days,
            note: event.note
          }
        end
      end
    end

    upcoming_items.sort_by! { |item| item[:days] }
  %>

  <% if upcoming_items.empty? %>
    <p style="color: var(--pico-muted-color);">🎈 Nothing coming up in the next 30 days — enjoy the break!</p>
  <% else %>
    <% upcoming_items.each do |item| %>
      <div class="birthday-card">
        <a href="/people/<%= item[:person].id %>">
          <%= item[:type] == :birthday ? "🎂" : "📅" %>
          <%= item[:label] %>
          <span class="person-meta"> — <%= item[:date] %></span>
          <% if item[:note].present? %>
            <span class="person-meta"> · <em><%= item[:note] %></em></span>
          <% end %>
        </a>
        <% if item[:days] == 0 %>
          <span class="days-badge today">🎉 Today!</span>
        <% else %>
          <span class="days-badge">⏰ <%= item[:days] %> days</span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</article>

<hr>

<%# Display 2: All People %>
<h2>👥 All People</h2>

<div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
  <a href="/people?sort=date" role="button" class="<%= params[:sort] == 'age' ? 'outline' : '' %>">
    📅 Sort by Date (Jan–Dec)
  </a>
  <a href="/people?sort=age" role="button" class="<%= params[:sort] == 'age' ? '' : 'outline' %>">
    🎂 Sort by Age
  </a>
</div>

<article>
  <%
    all_sorted = if params[:sort] == "age"
      @list_of_people.sort_by { |p| p.birthday }
    else
      @list_of_people.sort_by { |p| [p.birthday.month, p.birthday.day] }
    end
  %>
  <% if all_sorted.empty? %>
    <p style="color: var(--pico-muted-color);">No people added yet. <a href="/people/new">Add someone!</a></p>
  <% else %>
    <ul class="people-list">
      <% all_sorted.each do |a_person| %>
        <% days_until = (a_person.next_birthday - Date.today).to_i %>
        <li>
          <div>
            <a href="/people/<%= a_person.id %>"><strong><%= a_person.name %></strong></a>
            <br>
            <span class="person-meta">
              <%= a_person.birthday.strftime("%B %d, %Y") %>
              <% if a_person.relationship.present? %> · <%= a_person.relationship %><% end %>
            </span>
          </div>
          <% if days_until == 0 %>
            <span class="days-badge today">🎉 Today!</span>
          <% elsif days_until <= 30 %>
            <span class="days-badge">⏰ <%= days_until %> days</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</article>

<hr>
