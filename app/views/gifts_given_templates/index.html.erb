<h1>List of all gifts given</h1>

<hr>

<article>
  <header>
    <h2>Add a new gift</h2>
  </header>

  <form action="/people/<%= params[:person_id] %>/gifts_givens" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

    <div>
      <label for="gift_box">Gift</label>
      <input type="text" id="gift_box" name="query_gift">
    </div>

    <div>
      <label for="liked_box">Liked?</label>
      <input type="checkbox" id="liked_box" name="query_liked" value="true">
    </div>

    <div>
      <label for="given_on_box">Given on</label>
      <input type="date" id="given_on_box" name="query_given_on">
    </div>

    <div>
      <label for="notes_box">Notes</label>
      <input type="text" id="notes_box" name="query_notes">
    </div>

    <div>
      <label for="occasion_box">Occasion</label>
      <input type="text" id="occasion_box" name="query_occasion">
    </div>

    <div>
      <label for="price_box">Price</label>
      <input type="number" id="price_box" name="query_price">
    </div>

    <button type="submit">Create gift</button>
  </form>
</article>

<hr>

<article>
  <ul>
    <% @list_of_gifts_givens.each do |a_gifts_given| %>
      <li>
        <a href="/people/<%= a_gifts_given.person_id %>/gifts_givens/<%= a_gifts_given.id %>">
          <%= a_gifts_given.gift %> — <%= a_gifts_given.given_on %>
        </a>
      </li>
    <% end %>
  </ul>
</article>

<hr>
